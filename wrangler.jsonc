{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "controle-de-estoque",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Telas (HTML/CSS/JS) servidas direto pela Cloudflare; o resto (/api) cai no Worker
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "estoque",
      "database_id": "0df03f39-c90e-4b1f-8aef-27cce587a321"
    }
  ],
  "dev": {
    "port": 3000
  }
}
