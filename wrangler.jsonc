{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "controle-de-estoque",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Telas (HTML/CSS/JS) servidas direto pela Cloudflare; o resto (/api) cai no Worker
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "estoque",
      // Trocar pelo Database ID criado no painel (Storage & Databases > D1)
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "dev": {
    "port": 3000
  }
}
